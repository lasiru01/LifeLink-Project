rules_version = '2';

// ============================================================
// LifeLink document storage rules
// Paste into: Firebase console -> Storage -> Rules -> Publish
//
// Donor cards and lab reports are medical documents, so uploads are
// capped and only signed-in sessions can read them back.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /donor-docs/{nic}/{fileName} {
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');

      allow read: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

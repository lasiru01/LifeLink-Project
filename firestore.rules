rules_version = '2';

// ============================================================
// LifeLink database rules
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish
//
// The admin is the only account with a password, so "signed in with a
// password" is what identifies an admin. Donors and hospitals use the
// anonymous sign-in the page does for them automatically.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Marks that an administrator has been set up. It can be created once
    // and never overwritten, so nobody can claim the admin slot afterwards.
    match /config/admin {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Donors: anyone using the app can register and read the pool
    // (the page masks NIC and phone). Only an admin sets verification.
    match /donors/{donorId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.verified == false
        && request.resource.data.verification_status == 'pending';
      allow update: if isAdmin()
        || (signedIn()
            && request.resource.data.verification_status == resource.data.verification_status
            && request.resource.data.nic == resource.data.nic);
      allow delete: if signedIn();
    }

    // Hospitals: only an admin creates them and issues codes.
    match /hospitals/{hospitalId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if signedIn();   // stock changes from the hospital screen
    }

    match /alerts/{alertId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /alert_responses/{responseId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /donor_notifications/{notificationId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }
  }
}
